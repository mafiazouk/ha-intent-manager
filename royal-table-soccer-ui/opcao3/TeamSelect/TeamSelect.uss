/* ===== Team Select (opcao3 — Neon Arena) ===== */

.ts3-top {
    position: absolute;
    top: 24px; left: 60px; right: 60px;
    height: 96px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}
.ts3-top-center { flex-direction: column; align-items: center; }

.ts3-body {
    position: absolute;
    top: 140px; left: 60px; right: 60px;
    bottom: 140px;
    flex-direction: row;
    align-items: stretch;
    justify-content: center;
}

/* ----- Team pane ----- */
.ts3-team {
    flex-grow: 1.4;
    margin-right: 24px;
    align-items: center;
    justify-content: space-between;
    padding-top: 36px;
    padding-bottom: 36px;
}

.ts3-team-name {
    font-size: 80px;
    color: rgb(255, 255, 255);
    text-shadow: 0 0 18px rgb(255, 45, 200), 0 0 32px rgb(155, 91, 255);
    letter-spacing: 8px;
    -unity-text-align: middle-center;
}

.ts3-carousel {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-top: 18px;
    margin-bottom: 18px;
}
.ts3-carousel .rts3-chev { margin-left: 36px; margin-right: 36px; }

.ts3-crest {
    width: 280px;
    height: 280px;
    background-image: url("project://database/Assets/Sprites/UI/crest_placeholder.png");
    -unity-background-scale-mode: scale-to-fit;
}

/* ----- Stats ----- */
.ts3-stats {
    width: 80%;
    flex-direction: column;
    margin-top: 16px;
}

.ts3-stat {
    flex-direction: row;
    align-items: center;
    margin-top: 7px;
    margin-bottom: 7px;
}

.ts3-stat-lbl {
    width: 140px;
    font-size: 22px;
    color: rgba(220, 210, 255, 0.7);
    -unity-text-align: middle-left;
    letter-spacing: 4px;
}

.ts3-bar {
    flex-grow: 1;
    height: 20px;
    background-color: rgba(0, 0, 0, 0.55);
    border-left-width: 1px; border-right-width: 1px;
    border-top-width: 1px; border-bottom-width: 1px;
    border-left-color: rgba(155, 91, 255, 0.55);
    border-right-color: rgba(155, 91, 255, 0.55);
    border-top-color: rgba(155, 91, 255, 0.55);
    border-bottom-color: rgba(155, 91, 255, 0.55);
    border-top-left-radius: 999px;
    border-top-right-radius: 999px;
    border-bottom-left-radius: 999px;
    border-bottom-right-radius: 999px;
    overflow: hidden;
}

/* USS doesn't support gradients; use a pre-made gradient sprite
   Fall back: solid magenta with cyan border looks neon enough */
.ts3-bar-fill {
    height: 100%;
    width: 50%;
    background-color: rgb(255, 45, 200);
    background-image: url("project://database/Assets/Sprites/UI/bar_gradient.png");
    -unity-background-scale-mode: stretch-to-fill;
    transition-property: width;
    transition-duration: 240ms;
}

.ts3-stat-val {
    width: 80px;
    font-size: 28px;
    color: rgb(0, 245, 255);
    text-shadow: 0 0 8px rgb(0, 245, 255);
    -unity-text-align: middle-right;
    margin-left: 12px;
}

/* ----- Formation pane ----- */
.ts3-form {
    flex-grow: 1;
    align-items: center;
    justify-content: space-between;
    padding-top: 36px;
    padding-bottom: 36px;
}

.ts3-pitch {
    width: 90%;
    height: 440px;
    margin-top: 14px;
    background-color: rgb(10, 5, 38);
    background-image: url("project://database/Assets/Sprites/UI/pitch_neon.png");
    -unity-background-scale-mode: scale-and-crop;
    border-left-width: 2px; border-right-width: 2px;
    border-top-width: 2px; border-bottom-width: 2px;
    border-left-color: rgb(0, 245, 255);
    border-right-color: rgb(0, 245, 255);
    border-top-color: rgb(0, 245, 255);
    border-bottom-color: rgb(0, 245, 255);
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-left-radius: 14px;
    border-bottom-right-radius: 14px;
    flex-direction: column;
    justify-content: space-around;
    padding: 24px;
}

.ts3-pitch-line {
    flex-direction: row;
    justify-content: space-around;
    align-items: center;
    height: 80px;
}

.ts3-pitch-marker {
    width: 54px;
    height: 54px;
    border-top-left-radius: 999px;
    border-top-right-radius: 999px;
    border-bottom-left-radius: 999px;
    border-bottom-right-radius: 999px;
    background-color: rgb(255, 45, 200);
    background-image: url("project://database/Assets/Sprites/UI/marker_neon.png");
    -unity-background-scale-mode: scale-to-fit;
}

.ts3-form-switch {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-top: 18px;
}
.ts3-form-switch .rts3-chev { margin-left: 18px; margin-right: 18px; }

.ts3-form-nav { width: 60px; height: 60px; font-size: 28px; }

.ts3-form-lbl {
    font-size: 48px;
    color: rgb(255, 255, 255);
    text-shadow: 0 0 18px rgb(255, 45, 200), 0 0 32px rgb(155, 91, 255);
    letter-spacing: 10px;
    min-width: 300px;
    -unity-text-align: middle-center;
}

/* ----- Bottom ----- */
.ts3-bottom {
    position: absolute;
    bottom: 32px; left: 0; right: 0;
    flex-direction: row;
    justify-content: center;
    align-items: center;
}
.ts3-bottom > .rts3-neon-btn { margin-left: 24px; margin-right: 24px; }
