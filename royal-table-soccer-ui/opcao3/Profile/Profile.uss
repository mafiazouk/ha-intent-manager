/* ===== Profile (opcao3 — Neon Arena) ===== */

.pf3-top {
    position: absolute;
    top: 24px; left: 60px; right: 60px;
    height: 96px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.pf3-body {
    position: absolute;
    top: 140px; left: 60px; right: 60px;
    bottom: 140px;
    flex-direction: row;
    align-items: stretch;
}

/* ----- Hero ----- */
.pf3-hero {
    flex-grow: 1;
    flex-basis: 0;
    margin-right: 24px;
    align-items: center;
    padding-top: 36px;
    padding-bottom: 36px;
}

.pf3-avatar {
    width: 280px;
    height: 280px;
    border-top-left-radius: 999px;
    border-top-right-radius: 999px;
    border-bottom-left-radius: 999px;
    border-bottom-right-radius: 999px;
    background-image: url("project://database/Assets/Sprites/UI/avatar_placeholder.png");
    -unity-background-scale-mode: scale-and-crop;
}

.pf3-cam-row {
    flex-direction: row;
    margin-top: 14px;
}

.pf3-cam-pill {
    height: 50px;
    min-width: 130px;
    margin-left: 6px;
    margin-right: 6px;
    padding-left: 18px;
    padding-right: 18px;
    background-color: rgba(0, 0, 0, 0.55);
    border-left-width: 1px; border-right-width: 1px;
    border-top-width: 1px;  border-bottom-width: 1px;
    border-left-color: rgb(255, 45, 200);
    border-right-color: rgb(255, 45, 200);
    border-top-color: rgb(255, 45, 200);
    border-bottom-color: rgb(255, 45, 200);
    border-top-left-radius: 999px;
    border-top-right-radius: 999px;
    border-bottom-left-radius: 999px;
    border-bottom-right-radius: 999px;
    color: rgb(255, 255, 255);
    font-size: 18px;
    letter-spacing: 3px;
    text-shadow: 0 0 6px rgb(255, 45, 200);
    transition-property: scale, background-color;
    transition-duration: 120ms;
}
.pf3-cam-pill:hover {
    background-color: rgba(255, 45, 200, 0.18);
    scale: 1.04 1.04;
}

.pf3-name {
    margin-top: 24px;
    font-size: 76px;
    color: rgb(255, 255, 255);
    text-shadow: 0 0 18px rgb(255, 45, 200), 0 0 32px rgb(155, 91, 255);
    letter-spacing: 6px;
}

.pf3-level-row {
    flex-direction: row;
    align-items: center;
    margin-top: 6px;
}

.pf3-level {
    font-size: 32px;
    color: rgba(220, 210, 255, 0.7);
    letter-spacing: 6px;
}

.pf3-star {
    margin-left: 12px;
    font-size: 34px;
    color: rgb(57, 255, 156);
    text-shadow: 0 0 10px rgb(57, 255, 156);
}

.pf3-xp-row {
    margin-top: 24px;
    width: 80%;
    align-items: center;
}

.pf3-xp-bar {
    width: 100%;
    height: 24px;
    background-color: rgba(0, 0, 0, 0.55);
    border-left-width: 1px; border-right-width: 1px;
    border-top-width: 1px; border-bottom-width: 1px;
    border-left-color: rgba(155, 91, 255, 0.55);
    border-right-color: rgba(155, 91, 255, 0.55);
    border-top-color: rgba(155, 91, 255, 0.55);
    border-bottom-color: rgba(155, 91, 255, 0.55);
    border-top-left-radius: 999px;
    border-top-right-radius: 999px;
    border-bottom-left-radius: 999px;
    border-bottom-right-radius: 999px;
    overflow: hidden;
}

.pf3-xp-fill {
    height: 100%;
    width: 18%;
    background-color: rgb(57, 255, 156);
    background-image: url("project://database/Assets/Sprites/UI/bar_xp_gradient.png");
    -unity-background-scale-mode: stretch-to-fill;
    border-top-left-radius: 999px;
    border-bottom-left-radius: 999px;
    transition-property: width;
    transition-duration: 240ms;
}

.pf3-xp-text {
    margin-top: 8px;
    font-size: 22px;
    color: rgba(220, 210, 255, 0.7);
    letter-spacing: 3px;
}

/* ----- Right column ----- */
.pf3-right {
    flex-grow: 1.2;
    flex-basis: 0;
    flex-direction: column;
    justify-content: space-between;
}

.pf3-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
}

.pf3-stat {
    width: 47%;
    margin-bottom: 16px;
    padding-top: 24px;
    padding-bottom: 24px;
    background-color: rgba(28, 16, 80, 0.6);
    border-top-left-radius: 18px;
    border-top-right-radius: 18px;
    border-bottom-left-radius: 18px;
    border-bottom-right-radius: 18px;
    border-left-width: 2px; border-right-width: 2px;
    border-top-width: 2px;  border-bottom-width: 2px;
    align-items: center;
    justify-content: center;
}

.pf3-stat-cyan    { border-left-color: rgb(0, 245, 255); border-right-color: rgb(0, 245, 255); border-top-color: rgb(0, 245, 255); border-bottom-color: rgb(0, 245, 255); }
.pf3-stat-magenta { border-left-color: rgb(255, 45, 200); border-right-color: rgb(255, 45, 200); border-top-color: rgb(255, 45, 200); border-bottom-color: rgb(255, 45, 200); }
.pf3-stat-green   { border-left-color: rgb(57, 255, 156); border-right-color: rgb(57, 255, 156); border-top-color: rgb(57, 255, 156); border-bottom-color: rgb(57, 255, 156); }
.pf3-stat-purple  { border-left-color: rgb(155, 91, 255); border-right-color: rgb(155, 91, 255); border-top-color: rgb(155, 91, 255); border-bottom-color: rgb(155, 91, 255); }

.pf3-stat-lbl {
    font-size: 20px;
    color: rgba(220, 210, 255, 0.7);
    letter-spacing: 6px;
}

.pf3-stat-num {
    font-size: 88px;
    margin-top: 4px;
}

.pf3-stat-cyan .pf3-stat-num    { color: rgb(0, 245, 255); text-shadow: 0 0 18px rgb(0, 245, 255); }
.pf3-stat-magenta .pf3-stat-num { color: rgb(255, 45, 200); text-shadow: 0 0 18px rgb(255, 45, 200); }
.pf3-stat-green .pf3-stat-num   { color: rgb(57, 255, 156); text-shadow: 0 0 18px rgb(57, 255, 156); }
.pf3-stat-purple .pf3-stat-num  { color: rgb(155, 91, 255); text-shadow: 0 0 18px rgb(155, 91, 255); }

/* Badge card */
.pf3-badge {
    margin-top: 8px;
    padding-top: 24px;
    padding-bottom: 24px;
}

.pf3-badge-row {
    flex-direction: row;
    align-items: center;
    margin-top: 12px;
}

.pf3-badge-hex {
    width: 120px;
    height: 140px;
    margin-right: 24px;
    background-image: url("project://database/Assets/Sprites/UI/badge_hex.png");
    -unity-background-scale-mode: scale-to-fit;
}

.pf3-badge-text {
    flex-grow: 1;
    flex-direction: column;
}

.pf3-division {
    font-size: 46px;
    color: rgb(255, 255, 255);
    text-shadow: 0 0 16px rgb(255, 45, 200), 0 0 28px rgb(155, 91, 255);
    letter-spacing: 6px;
    -unity-text-align: middle-left;
}

.pf3-division-sub {
    margin-top: 4px;
    font-size: 22px;
    color: rgba(220, 210, 255, 0.7);
    letter-spacing: 1px;
    -unity-text-align: middle-left;
}

.pf3-promo-bar {
    margin-top: 12px;
    width: 100%;
    height: 14px;
    background-color: rgba(0, 0, 0, 0.55);
    border-left-width: 1px; border-right-width: 1px;
    border-top-width: 1px;  border-bottom-width: 1px;
    border-left-color: rgba(155, 91, 255, 0.55);
    border-right-color: rgba(155, 91, 255, 0.55);
    border-top-color: rgba(155, 91, 255, 0.55);
    border-bottom-color: rgba(155, 91, 255, 0.55);
    border-top-left-radius: 999px;
    border-top-right-radius: 999px;
    border-bottom-left-radius: 999px;
    border-bottom-right-radius: 999px;
    overflow: hidden;
}

.pf3-promo-fill {
    height: 100%;
    width: 33%;
    background-color: rgb(255, 45, 200);
    background-image: url("project://database/Assets/Sprites/UI/bar_gradient.png");
    -unity-background-scale-mode: stretch-to-fill;
    border-top-left-radius: 999px;
    border-bottom-left-radius: 999px;
    transition-property: width;
    transition-duration: 240ms;
}

/* Bottom */
.pf3-bottom {
    position: absolute;
    bottom: 32px; left: 0; right: 0;
    flex-direction: row;
    justify-content: center;
    align-items: center;
}
.pf3-bottom > .rts3-neon-btn { margin-left: 24px; margin-right: 24px; }
