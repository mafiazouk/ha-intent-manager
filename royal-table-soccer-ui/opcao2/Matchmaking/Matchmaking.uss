/* ===== Matchmaking (opcao2 — title bout) ===== */

.mm2-bg-left {
    position: absolute;
    left: -10%; top: -10%;
    width: 70%; height: 140%;
    background-color: rgba(92, 182, 255, 0.18);
    rotate: -12deg;
}

.mm2-bg-right {
    position: absolute;
    right: -10%; top: -10%;
    width: 70%; height: 140%;
    background-color: rgba(229, 34, 60, 0.22);
    rotate: -12deg;
}

.mm2-header {
    position: absolute;
    top: 36px; left: 0; right: 0;
    align-items: center;
}

.mm2-title {
    font-size: 42px;
    color: rgb(244, 241, 232);
    letter-spacing: 10px;
    margin-top: 6px;
}

.mm2-timer {
    margin-top: 8px;
    font-size: 120px;
    color: rgb(255, 184, 0);
    letter-spacing: 14px;
}

.mm2-status {
    font-size: 22px;
    color: rgba(244, 241, 232, 0.6);
    letter-spacing: 6px;
}

/* ----- Arena ----- */
.mm2-arena {
    position: absolute;
    top: 340px; left: 0; right: 0;
    bottom: 200px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.mm2-fighter {
    width: 520px;
    height: 620px;
    flex-direction: column;
    justify-content: flex-end;
    align-items: center;
    padding-bottom: 30px;
    background-color: rgba(0, 0, 0, 0.55);
    border-left-width: 3px; border-right-width: 3px;
    border-top-width: 3px;  border-bottom-width: 3px;
}

.mm2-fighter-left {
    border-left-color: rgb(92, 182, 255);
    border-right-color: rgb(92, 182, 255);
    border-top-color: rgb(92, 182, 255);
    border-bottom-color: rgb(92, 182, 255);
}

.mm2-fighter-right {
    border-left-color: rgb(229, 34, 60);
    border-right-color: rgb(229, 34, 60);
    border-top-color: rgb(229, 34, 60);
    border-bottom-color: rgb(229, 34, 60);
}

.mm2-fighter-photo {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    background-image: url("project://database/Assets/Sprites/UI/avatar_placeholder.png");
    -unity-background-scale-mode: scale-and-crop;
}

.mm2-fighter-photo-unknown {
    background-color: rgb(13, 19, 34);
    background-image: none;
    align-items: center;
    justify-content: center;
}

.mm2-fighter-question {
    font-size: 240px;
    color: rgba(244, 241, 232, 0.25);
}

.mm2-fighter-info {
    align-items: center;
    background-color: rgba(0, 0, 0, 0.65);
    padding: 10px 28px;
    margin-bottom: 0;
}

.mm2-fighter-name {
    font-size: 62px;
    letter-spacing: 8px;
}

.mm2-name-left  { color: rgb(92, 182, 255); }
.mm2-name-right { color: rgb(255, 79, 102); }

.mm2-fighter-meta {
    margin-top: 6px;
    font-size: 24px;
    color: rgba(244, 241, 232, 0.6);
    letter-spacing: 6px;
}

/* VS center */
.mm2-vs {
    width: 300px;
    margin-left: -40px;
    margin-right: -40px;
    align-items: center;
    justify-content: center;
}

.mm2-vs-text {
    font-size: 220px;
    color: rgb(255, 184, 0);
    letter-spacing: 4px;
    -unity-text-align: middle-center;
}

.mm2-pulse {
    width: 140px;
    height: 6px;
    margin-top: 8px;
    background-color: rgb(255, 184, 0);
}

/* Compare row */
.mm2-compare {
    position: absolute;
    left: 0; right: 0; bottom: 140px;
    flex-direction: row;
    justify-content: center;
}

.mm2-compare-col {
    flex-direction: row;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.55);
    border-left-width: 1px; border-right-width: 1px;
    border-top-width: 1px;  border-bottom-width: 1px;
    border-left-color: rgba(255, 184, 0, 0.5);
    border-right-color: rgba(255, 184, 0, 0.5);
    border-top-color: rgba(255, 184, 0, 0.5);
    border-bottom-color: rgba(255, 184, 0, 0.5);
    padding: 14px 28px;
    margin-left: 12px;
    margin-right: 12px;
}

.mm2-cmp-v {
    font-size: 30px;
    color: rgb(255, 184, 0);
    min-width: 60px;
    -unity-text-align: middle-center;
}

.mm2-cmp-vL { color: rgb(92, 182, 255); }
.mm2-cmp-vR { color: rgb(255, 79, 102); }

.mm2-cmp-vs {
    font-size: 30px;
    color: rgb(255, 184, 0);
    margin-left: 12px;
    margin-right: 12px;
}

.mm2-cmp-k {
    font-size: 18px;
    color: rgba(244, 241, 232, 0.6);
    letter-spacing: 4px;
    margin-left: 8px;
    margin-right: 8px;
}

/* Bottom */
.mm2-bottom {
    position: absolute;
    bottom: 36px; left: 0; right: 0;
    flex-direction: row;
    justify-content: center;
}
